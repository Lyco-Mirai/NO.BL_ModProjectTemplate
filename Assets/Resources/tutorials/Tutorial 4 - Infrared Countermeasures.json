  "objectives": [
    {
      "Type": "None",
      "UniqueName": "Mission Start",
      "Faction": "",
      "DisplayName": "",
      "Hidden": true,
      "Outcomes": [
        "show box 1"
      ]
    },
    {
      "Type": "DialogueBox",
      "UniqueName": "box 1",
      "Faction": "Primeva",
      "DisplayName": "box 1",
      "Hidden": false,
      "Outcomes": [
        "show box 2"
      ],
      "title": "Infrared Countermeasures          1/3",
      "body": "Missiles that see via the infrared spectral band are a common battlefield threat.\n\nThe signature of your aircraft is provided to them by the heat that operating it produces.",
      "button": "Next",
      "factionOnly": false
    },
    {
      "Type": "DialogueBox",
      "UniqueName": "box 2",
      "Faction": "Primeva",
      "DisplayName": "box 2",
      "Hidden": false,
      "Outcomes": [
        "show box 3"
      ],
      "title": "Infrared Countermeasures          2/3",
      "body": "You can defeat IR missiles by using flares - intense heat signatures - that can either distract or dazzle the seeker head.\n\nEvery aircraft in the arsenal has flares.",
      "button": "Next",
      "factionOnly": false
    },
    {
      "Type": "DialogueBox",
      "UniqueName": "box 3",
      "Faction": "Primeva",
      "DisplayName": "box 3",
      "Hidden": false,
      "Outcomes": [
        "start moving"
      ],
      "title": "Infrared Countermeasures          3/3",
      "body": "In front of you is an enemy SAM launcher which fires IRM-S2s. It has an effective range of 8km (5 miles).\n\nTo pass the training, you will have to fly within half that distance from it, and then return to this point alive.",
      "button": "Oh.",
      "factionOnly": false
    },
    {
      "Type": "ReachWaypoints",
      "UniqueName": "started moving",
      "Faction": "Primeva",
      "DisplayName": "started moving",
      "Hidden": true,
      "Outcomes": [
        "show box 4"
      ],
      "completeOrder": "CompleteAny",
      "completeSomePercent": 0.5,
      "completeOnEnterRange": false,
      "waypoints": [
        {
          "Position": {
            "x": 29138.9121,
            "y": 999.1808,
            "z": -21123.082
          },
          "Range": 1000.0
        }
      ]
    },
    {
      "Type": "DialogueBox",
      "UniqueName": "box 4",
      "Faction": "Primeva",
      "DisplayName": "box 4",
      "Hidden": false,
      "Outcomes": [
        "show box 5"
      ],
      "title": "Flare Usage                                 1/3",
      "body": "Make sure flares are selected and visible in the top right of the HMD <bind=Next Countermeasure>\n\nWhen fired on, press and hold the Countermeasure button. <bind=Countermeasures>",
      "button": "Next",
      "factionOnly": false
    },
    {
      "Type": "DialogueBox",
      "UniqueName": "box 5",
      "Faction": "Primeva",
      "DisplayName": "box 5",
      "Hidden": false,
      "Outcomes": [
        "show box 6"
      ],
      "title": "Flare Usage                                 2/3",
      "body": "Flare effectiveness is determined by your aspect to the missile, as well as your engine output. Lower your throttle and turn the plane side-on to the threat to get the most out of your flares. If you get fired on from behind at full throttle, or you may need to expend the whole cartridge.",
      "button": "Next",
      "factionOnly": false
    },
    {
      "Type": "DialogueBox",
      "UniqueName": "box 6",
      "Faction": "Primeva",
      "DisplayName": "box 6",
      "Hidden": false,
      "Outcomes": [
        "start tempting fate"
      ],
      "title": "Flare Usage                                 3/3",
      "body": "Pre-flaring (releasing flares if you suspect you're about to be fired on) is the most effective use of flares, as it can prevent the launching platform from obtaining a lock.\nTry releasing flares periodically (once or twice a second) when in danger.",
      "button": "Ok",
      "factionOnly": false
    },
