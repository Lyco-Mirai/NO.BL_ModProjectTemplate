      "Hidden": false,
      "Outcomes": [
        "spawn target trucks",
        "show box 4"
      ],
      "completeOrder": "CompleteAny",
      "completeSomePercent": 0.5,
      "completeOnEnterRange": false,
      "waypoints": [
        {
          "Position": {
            "x": -23887.0156,
