    {
      "Type": "DialogueBox",
      "UniqueName": "Box 2 - Deploy Gear",
      "Faction": "Primeva",
      "DisplayName": "Box 2 - Deploy Gear",
      "Hidden": false,
      "Outcomes": [],
      "title": "Deploy Gear",
      "body": "Lower your landing gear using <bind=Gear> or the radial menu <bind=Radial Menu> + <bind=Radial Menu Horizontal>\n\nYour flaps will automatically lower to landing position at slower speeds - you will notice a change in handling.",
      "button": "Ok",
      "factionOnly": false
