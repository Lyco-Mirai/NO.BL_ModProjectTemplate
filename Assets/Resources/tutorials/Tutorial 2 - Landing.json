    {
      "Type": "DialogueBox",
      "UniqueName": "Box 3 - Landing Assist",
      "Faction": "Primeva",
      "DisplayName": "Box 3 - Landing Assist",
      "Hidden": false,
      "Outcomes": [
        "open box 3.1"
      ],
      "title": "Landing Assist                   1/3",
      "body": "Lowering your gear has also activated the landing assist on the HUD.\u000b\u000bIt has two features: The Glideslope indicator, and the Angle of Attack (AoA) Indexer",
      "button": "Next",
      "factionOnly": false
    },
    {
      "Type": "DialogueBox",
      "UniqueName": "Box 3.1 - Landing Assist Pt1",
      "Faction": "Primeva",
      "DisplayName": "Box 3.1 - Landing Assist Pt1",
      "Hidden": false,
      "Outcomes": [
        "open box 3.2"
      ],
      "title": "Glideslope indicator          2/3",
      "body": "The line coming out of the runway with a small circle at the end is your glideslope indicator.\n\nAs you glide, steer so that your velocity vector envelops the small circle at the end of the glideslope.",
      "button": "Next",
      "factionOnly": false
    },
    {
      "Type": "DialogueBox",
      "UniqueName": "Box 3.2 - Landing Assist Pt2",
      "Faction": "Primeva",
      "DisplayName": "Box 3.2 - Landing Assist Pt2",
      "Hidden": false,
      "Outcomes": [],
      "title": "Angle of Attack Indexer     3/3",
      "body": "On the left side of the HUD is your angle of attack indexer. Green is too slow, yellow is on speed, and red is too fast.\u000bWhile steering, adjust the throttle to keep the AoA indexer showing a yellow circle. Continue until you touch down.",
      "button": "Ok",
      "factionOnly": false
    },
