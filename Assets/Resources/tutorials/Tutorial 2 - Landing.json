    {
      "Type": "DialogueBox",
      "UniqueName": "Box 1 - Prepare for Landing",
      "Faction": "Primeva",
      "DisplayName": "Box 1 - Prepare for Landing",
      "Hidden": false,
      "Outcomes": [],
      "title": "Prepare for Landing",
      "body": "The airstrip you'll be landing at is directly infront of you. Start by reducing your throttle <bind=Throttle:neg> to zero - this will deploy the airbrake.\n\u000bTry to bring your speed down to at most 375kph (200 knots) before the next waypoint.",
      "button": "Ok",
      "factionOnly": false
    },
