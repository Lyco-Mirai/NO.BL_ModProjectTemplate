  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 63}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 1453722849, guid: 67dfb1fdfb2b407222eda8e23ac8b724, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In order to prepare for future improvements to Nuclear Option's Input System, we updated the Input Manager we use to a much newer version.\n\nUnfortunately, this will cause some Flight Sim controllers' input configuration (bindings and calibration), to Reset to Default.\n\nEfforts have been made to migrate settings from the old structure but this may not work for devices from all the different Vendors and Manufacturers.\n\nWe recommend to visit the Control Settings Menu and check the binds and calibration for all your connected devices.\n\nWe sincerely apologize for any inconvenience caused by this."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 83dd0172a226f5644919a67a836f3ee4, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: f0c70e9eff921ce4c9fe6c69e2bd0650, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
